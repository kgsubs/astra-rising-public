# Astra Rising: environment variables
# Copy this file to .env and fill in values before starting the server.

# AI providers: at least one key is required.
# Groq key (preferred: faster, and the larger free daily allowance, 1000
# requests/day, 200k tokens/day on openai/gpt-oss-120b).
# Verify the model still exists: GET https://api.groq.com/openai/v1/models
GROQ_API_KEY=
# Google AI Studio key (backup, for per-minute bursts and outages: 20 free
# requests/day on gemini-2.5-flash, measured, large context).
GEMINI_API_KEY=

# Optional provider overrides
# Model name per provider (defaults: gemini-2.5-flash / openai/gpt-oss-120b).
# GEMINI_MODEL=
# GROQ_MODEL=
# Provider base URL, only for pointing at a local stub in tests/dev.
# GEMINI_URL=
# GROQ_URL=
# Free-tier ceiling overrides, used for quota math (defaults: Groq 1000
# requests/day, 200k tokens/day; Gemini 20 requests/day and no token ceiling).
# GROQ_REQUESTS_PER_DAY=
# GROQ_TOKENS_PER_DAY=
# GEMINI_REQUESTS_PER_DAY=
# GEMINI_TOKENS_PER_DAY=
# Provider preference / fallback order, comma-separated (default: groq,gemini)
# AI_PROVIDER_ORDER=

# Set when running behind nginx so rate limits see the real client IP.
# TRUST_PROXY=

# HTTP port for the Express server (default: 3500)
PORT=3500

# Path to the SQLite database file (default: ./astra_rising.db)
DB_PATH=./astra_rising.db

# Set to "production" when deployed.
# NODE_ENV=

# Per-turn provider timeout in milliseconds (default: 20000)
# AI_TURN_TIMEOUT_MS=

# Rate limiting, /api/chat, keyed on session token (default: 100 per hour)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=3600000

# Rate limiting, /api/chat, keyed on client IP (default: 150 per hour)
# IP_RATE_LIMIT_MAX=
# IP_RATE_LIMIT_WINDOW_MS=

# Rate limiting, /api/chat daily cap, keyed on session token (default: 300/day)
# SESSION_DAILY_RATE_LIMIT_MAX=
# SESSION_DAILY_RATE_LIMIT_WINDOW_MS=

# Rate limiting, session creation, keyed on client IP (default: 20 per hour)
SESSION_RATE_LIMIT_MAX=20
SESSION_RATE_LIMIT_WINDOW_MS=3600000

# Rate limiting, PUT .../state, keyed on session token (default: 200 per hour)
# SAVE_STATE_RATE_LIMIT_MAX=
# SAVE_STATE_RATE_LIMIT_WINDOW_MS=

# Rate limiting, .../modules routes, keyed on session token (default: 60 per hour)
# MODULE_RATE_LIMIT_MAX=
# MODULE_RATE_LIMIT_WINDOW_MS=

# QA harness, only used by `npm run qa -- --real`
# URL of a real deployment to test against; no default, required for --real.
# QA_REAL_BASE=
# Path to the browser automation binary used by the QA harness.
# AGENT_BROWSER_BIN=
# Directory for QA screenshots and reports (default: a runs/ folder next to the QA harness)
# QA_SHOT_DIR=
