# Astra Rising - environment variables
# Copy this file to .env and fill in values before starting the server.

# AI providers — at least one key is required.
# Google AI Studio key (preferred: 250 free requests/day, large context).
GEMINI_API_KEY=
# Groq key (fallback: 100k free tokens/day, ~14 turns).
# Verify the model still exists: GET https://api.groq.com/openai/v1/models
GROQ_API_KEY=gsk_...

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# Provider preference / fallback order (comma-separated)
# AI_PROVIDER_ORDER=gemini,groq

# Set when running behind nginx so rate limits see the real client IP.
# TRUST_PROXY=1

# HTTP port for the Express server (default: 3500)
PORT=3500

# Path to the SQLite database file (default: ./astra_rising.db)
DB_PATH=./astra_rising.db

# Rate limiting — requests per session token per window (default: 100)
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (default: 3600000 = 1 hour)
RATE_LIMIT_WINDOW_MS=3600000

# Session creation rate limit — max new sessions per IP per window (default: 20)
SESSION_RATE_LIMIT_MAX=20

# Session creation rate limit window in milliseconds (default: 3600000 = 1 hour)
SESSION_RATE_LIMIT_WINDOW_MS=3600000
