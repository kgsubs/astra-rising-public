{
  "astra_rules_system": {
    "name": "Astra Rising Complete Rules Reference",
    "version": "1.0",
    "description": "Unified AI-readable rule system for Astra Rising RPG",
    "files": [
      {
        "id": "core_basic",
        "file": "rules_core_basic.json",
        "type": "core",
        "name": "Astra Rising Core Rules",
        "description": "Foundational rules for character creation, combat, and gameplay",
        "dependencies": [],
        "supplements": [
          "core_expanded",
          "korvaths_guide"
        ],
        "required": true
      },
      {
        "id": "core_expanded",
        "file": "rules_core_expanded.json",
        "type": "expansion",
        "name": "Astra Rising Core Extended Rules",
        "description": "Additional skills, detailed equipment, advanced combat options",
        "dependencies": [
          "core_basic"
        ],
        "supplements": [
          "korvaths_guide"
        ],
        "required": false
      },
      {
        "id": "korvaths_guide",
        "file": "rules_korvaths_guide.json",
        "type": "major_expansion",
        "name": "Korvath's Guide to the Frontier",
        "description": "Resolution Table system, 3 new races, 6 professions, 100+ skills",
        "dependencies": [
          "core_basic"
        ],
        "supplements": [
          "core_expanded"
        ],
        "required": false,
        "note": "Replaces simple percentile rolls with Resolution Table"
      },
      {
        "id": "gamma_rising",
        "file": "rules_gamma_rising.json",
        "type": "alternate_expansion",
        "name": "Gamma Rising",
        "description": "Optional rules: psionics, mutations, cybernetics, variant races",
        "dependencies": [
          "core_basic"
        ],
        "supplements": [
          "core_expanded",
          "korvaths_guide"
        ],
        "required": false,
        "note": "These rules are optional and may replace or augment standard rules"
      }
    ],
    "usage_guide": {
      "minimum_required": [
        "core_basic"
      ],
      "recommended_core": [
        "core_basic",
        "core_expanded"
      ],
      "full_experience": [
        "core_basic",
        "core_expanded",
        "korvaths_guide"
      ],
      "ground_campaign": [
        "core_basic",
        "core_expanded",
        "korvaths_guide"
      ]
    },
    "ai_query_patterns": {
      "character_creation": {
        "ability_scores": "core_basic.character_creation.ability_scores",
        "races": "core_basic.character_creation.races OR korvaths_guide.new_races",
        "skills": "core_basic.skills OR korvaths_guide.expanded_skill_system",
        "professions": "korvaths_guide.professions"
      },
      "combat": {
        "basic": "core_basic.combat",
        "expanded": "core_expanded.combat_expanded",
        "resolution_table": "korvaths_guide.resolution_table",
        "weapons": "core_expanded.equipment.weapons",
        "armor": "core_expanded.equipment.armor"
      },
      "equipment": {
        "weapons": "core_expanded.equipment.weapons",
        "armor": "core_expanded.equipment.armor",
        "gear": "core_expanded.equipment.gear"
      },
      "optional_rules": {
        "psionics": "gamma_rising.psionics",
        "mutations": "gamma_rising.mutations",
        "cybernetics": "gamma_rising.cybernetics",
        "reputation": "gamma_rising.reputation_system"
      }
    },
    "quick_reference": {
      "dice_system": {
        "primary": "d100 (percentile)",
        "secondary": "d10 for damage, initiative",
        "resolution_table": "d100 with column shifts (Korvath's Guide)"
      },
      "ability_scores": {
        "pairs": [
          "STR/STA",
          "DEX/RS",
          "INT/LOG",
          "PER/LDR"
        ],
        "generation": "Roll d100 for each pair",
        "racial_modifiers": "Apply based on chosen race"
      },
      "skill_checks": {
        "basic": "Roll d100 vs (1/2 ability + 10% per skill level)",
        "resolution_table": "Roll on table based on skill level and modifiers"
      },
      "combat_initiative": {
        "basic": "1d10 + (RS/10, round up)"
      },
      "damage": {
        "hit_points": "STA score",
        "unconscious": "0 STA",
        "death": "-30 STA"
      }
    },
    "versioning": {
      "current": "1.0",
      "last_updated": "2026-03-11",
      "compatibility": "All files designed to work together as unified system"
    }
  }
}
