{
  "name": "astra-rising",
  "version": "1.0.0",
  "description": "Astra Rising - AI game master for a science-fiction tabletop RPG, Node/Express with SQLite persistence",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "build:css": "tailwindcss -i tailwind.source.css -o public/app.css --minify",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.19"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
