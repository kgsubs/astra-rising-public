    "core_skills": {
      "beam_weapons": {
        "psa": "Military",
        "description": "Use of laser and energy weapons",
        "base_chance": "1/2 DEX",
        "per_level": "+10%"
      },
      "projectile_weapons": {
        "psa": "Military",
        "description": "Use of bullet and jyro weapons",
        "base_chance": "1/2 DEX",
        "per_level": "+10%"
      },
      "melee_weapons": {
        "psa": "Military",
        "description": "Use of swords, axes, clubs",
