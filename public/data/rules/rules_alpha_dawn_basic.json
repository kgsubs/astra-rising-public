{
  "ruleset": {
    "id": "alpha_dawn_basic",
    "name": "Astra Rising Core Rules",
    "version": "1.0",
    "type": "core",
    "description": "Foundational rules for character creation, combat, and gameplay in the Astra Rising RPG",
    "dependencies": [],
    "supplements": [
      "alpha_dawn_expanded",
      "zebulons_guide",
      "knight_hawks"
    ]
  },
  "character_creation": {
    "ability_scores": {
      "description": "Eight ability scores grouped in pairs, rolled on d100",
      "generation_method": "Roll d100 for each pair base score",
      "pairs": [
        {
          "name": "STR/STA",
          "full_names": [
            "Strength",
            "Stamina"
          ],
          "description": "Physical power and endurance",
          "typical_range": "30-70"
        },
        {
          "name": "DEX/RS",
          "full_names": [
            "Dexterity",
            "Reaction Speed"
          ],
          "description": "Agility and reflexes",
          "typical_range": "30-70"
        },
        {
          "name": "INT/LOG",
          "full_names": [
            "Intuition",
            "Logic"
          ],
          "description": "Perception and reasoning",
          "typical_range": "30-70"
        },
        {
          "name": "PER/LDR",
          "full_names": [
            "Personality",
            "Leadership"
          ],
          "description": "Charisma and command ability",
          "typical_range": "30-70"
        }
      ],
      "maximum": 100,
      "minimum": 1
    },
    "races": {
      "description": "Four playable races in the basic rules",
      "available": [
        "human",
        "dralasite",
        "vrusk",
        "yazirian"
      ],
      "human": {
        "description": "Most adaptable and versatile race",
        "ability_modifiers": "+5 to any one ability score",
        "special_abilities": [
          "Versatility - can excel in any field"
        ],
        "movement": "10 meters/turn",
        "size": "Medium"
      },
      "dralasite": {
        "description": "Amoeboid shape-changers with elastic bodies",
        "ability_modifiers": {
          "STR": "+5",
          "STA": "+5",
          "DEX": "-5",
          "RS": "-5"
        },
        "special_abilities": [
          {
            "name": "Elasticity",
            "description": "Can stretch limbs up to 3x normal length, squeeze through small openings"
          },
          {
            "name": "Lie Detection",
            "description": "5% base chance to detect lies through chemical senses"
          },
          {
            "name": "Shape Alteration",
            "description": "Can form limbs as needed, become flat (10cm thick), form protective coating"
          }
        ],
        "movement": "10 meters/turn (can roll at walking speed)",
        "size": "Medium (variable)"
      },
      "vrusk": {
        "description": "Insectoid beings with eight limbs and corporate mindset",
        "ability_modifiers": {
          "DEX": "+5",
          "RS": "+5",
          "INT": "+5",
          "LOG": "+5",
          "STR": "-5",
          "STA": "-5"
        },
        "special_abilities": [
          {
            "name": "Ambidexterity",
            "description": "Can use all limbs equally well, no penalty for two-weapon fighting"
          },
          {
            "name": "Comprehension",
            "description": "15% base chance to understand any language or communication"
          },
          {
            "name": "Corporate Mindset",
            "description": "Natural aptitude for business and organization"
          }
        ],
        "movement": "15 meters/turn",
        "size": "Medium"
      },
      "yazirian": {
        "description": "Ape-like humanoids with gliding membranes and warrior culture",
        "ability_modifiers": {
          "DEX": "+5",
          "RS": "+5",
          "INT": "+5",
          "LOG": "+5",
          "STR": "-10",
          "STA": "-10"
        },
        "special_abilities": [
          {
            "name": "Gliding",
            "description": "Can glide 1 meter forward for every 1 meter descended"
          },
          {
            "name": "Night Vision",
            "description": "Can see in dim light, but -15% in bright light"
          },
          {
            "name": "Battle Rage",
            "description": "5% chance to enter battle frenzy (+20% to hit, fight to unconsciousness)"
          }
        ],
        "movement": "10 meters/turn",
        "size": "Medium"
      }
    },
    "primary_skill_areas": {
      "description": "Three broad categories of skills",
      "military": {
        "description": "Combat and physical skills",
        "skills": [
          "Beam Weapons",
          "Projectile Weapons",
          "Melee Weapons",
          "Martial Arts",
          "Grenades",
          "Demolitions"
        ]
      },
      "technological": {
        "description": "Technical and mechanical skills",
        "skills": [
          "Computers",
          "Robotics",
          "Technician",
          "Engineering"
        ]
      },
      "biosocial": {
        "description": "Social and biological sciences",
        "skills": [
          "Environmental",
          "Medical",
          "Psychosocial"
        ]
      }
    },
    "starting_equipment": {
      "credits": "250 + d100",
      "standard_pack": {
        "cost": "150 Cr",
        "contents": [
          "chronocom",
          "coveralls",
          "first_aid_pack",
          "flashlight",
          "pocket_tool",
          "toxy-rad_gauge"
        ]
      }
    }
  },
