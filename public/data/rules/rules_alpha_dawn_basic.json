        "per_level": "+10%"
      },
      "martial_arts": {
        "psa": "Military",
        "description": "Unarmed combat techniques",
        "base_chance": "1/2 STR or DEX",
        "per_level": "+10%",
        "special": "Each level adds +5 to punching damage"
      },
      "grenades": {
        "psa": "Military",
        "description": "Throwing and using grenades",
        "base_chance": "1/2 DEX",
        "per_level": "+10%"
      },
      "computers": {
        "psa": "Technological",
        "description": "Programming, hacking, data retrieval",
        "base_chance": "1/2 LOG",
        "per_level": "+10%"
      },
      "robotics": {
        "psa": "Technological",
        "description": "Building, repairing, programming robots",
        "base_chance": "1/2 LOG",
        "per_level": "+10%"
      },
      "technician": {
        "psa": "Technological",
        "description": "Operating, repairing machinery",
        "base_chance": "1/2 LOG",
        "per_level": "+10%",
        "subskills": [
          "Operate Machinery",
          "Repair Machinery",
          "Detect Alarms",
          "Defeat Alarms",
          "Open Locks"
        ]
      },
      "environmental": {
        "psa": "Biosocial",
        "description": "Survival, tracking, nature lore",
        "base_chance": "1/2 INT",
        "per_level": "+10%"
      },
      "medical": {
        "psa": "Biosocial",
        "description": "Healing, diagnosis, treatment",
        "base_chance": "1/2 INT",
        "per_level": "+10%",
        "subskills": [
          "Diagnosis",
          "Treatment: Wounds",
          "Treatment: Disease",
          "Treatment: Poison",
          "Treatment: Radiation"
        ]
      },
      "psychosocial": {
        "psa": "Biosocial",
        "description": "Persuasion, psychology, social manipulation",
        "base_chance": "1/2 PER",
        "per_level": "+10%"
      }
    }
  },
  "combat": {
    "description": "Ground combat resolution system",
    "initiative": {
      "method": "1d10 + Initiative Modifier (IM)",
      "im_calculation": "RS / 10 (round up)",
      "order": "Highest to lowest"
    },
    "combat_sequence": [
      "Check for surprise (Intuition check)",
      "Roll for initiative",
      "Declare actions (Side B first)",
      "Side B moves (Side A gets opportunity fire)",
      "Side A moves (Side B gets opportunity fire)",
      "Resolve wrestling",
      "Resolve ranged and melee combat"
    ],
    "to_hit": {
      "base_chance": "1/2 relevant ability score",
      "modifiers": {
        "point_blank": "+20%",
        "short_range": "0%",
        "medium_range": "-10%",
