{
  "ruleset": {
    "id": "knight_hawks",
    "name": "Astra Rising: Knights Rising",
    "version": "1.0",
    "type": "expansion",
    "description": "Starship combat, construction, and space travel rules for Astra Rising",
    "dependencies": [
      "alpha_dawn_basic"
    ],
    "supplements": [
      "knight_hawks_expanded"
    ],
    "adds_to_core": [
      "Starship combat",
      "Ship construction",
      "Space travel",
      "Spaceship skills"
    ]
  },
  "starship_basics": {
    "hull_sizes": {
      "description": "Ships are classified by hull size (1-20)",
      "hull_points": "Hull Size x 5",
      "dcr": "(Hull Size x 3) + 20",
      "examples": {
        "1": "Fighter",
        "3": "Assault Scout",
        "5": "Frigate",
        "6": "Destroyer",
        "20": "Battleship",
        "12-14": "Light Cruiser",
        "16-18": "Heavy Cruiser"
      }
    },
    "ship_statistics": {
      "adf": {
        "name": "Acceleration/Deceleration Factor",
        "description": "How fast ship can speed up or slow down",
        "range": "1-5",
        "effect": "ADF = number of hexes speed can change per turn"
      },
      "mr": {
        "name": "Maneuver Rating",
        "description": "How many 60-degree turns ship can make per turn",
        "range": "1-5"
      },
      "hull_points": {
        "description": "Ship's structural integrity",
        "calculation": "Hull Size x 5"
      },
      "dcr": {
        "name": "Damage Control Rating",
        "description": "Crew's ability to repair damage in combat",
        "calculation": "(Hull Size x 3) + 20"
      }
    }
  },
