      }
    },
    "quick_reference": {
      "dice_system": {
        "primary": "d100 (percentile)",
        "secondary": "d10 for damage, initiative",
        "resolution_table": "d100 with column shifts (Korvath's Guide)"
      },
      "ability_scores": {
        "pairs": [
          "STR/STA",
          "DEX/RS",
          "INT/LOG",
          "PER/LDR"
        ],
        "generation": "Roll d100 for each pair",
        "racial_modifiers": "Apply based on chosen race"
      },
      "skill_checks": {
        "basic": "Roll d100 vs (1/2 ability + 10% per skill level)",
        "resolution_table": "Roll on table based on skill level and modifiers"
      },
      "combat_initiative": {
        "basic": "1d10 + (RS/10, round up)"
      },
      "damage": {
        "hit_points": "STA score",
        "unconscious": "0 STA",
        "death": "-30 STA"
      }
    },
    "versioning": {
      "current": "1.0",
      "last_updated": "2026-03-11",
      "compatibility": "All files designed to work together as unified system"
