      "starships": {
        "basics": "knight_hawks.starship_basics",
        "types": "knight_hawks.ship_types",
        "weapons": "knight_hawks.ship_weapons",
        "defenses": "knight_hawks.defenses",
        "combat": "knight_hawks.starship_combat",
