{
  "ruleset": {
    "id": "zebulons_guide",
    "name": "Astra Rising: Korvath's Guide to the Frontier",
    "version": "1.0",
    "type": "major_expansion",
    "description": "Major expansion adding new races, the Resolution Table system, professions, and 100+ skills",
    "dependencies": [
      "alpha_dawn_basic"
    ],
    "supplements": [
      "alpha_dawn_expanded",
      "knight_hawks"
    ],
    "adds_to_core": [
      "Resolution Table",
      "3 new races",
      "6 professions",
      "100+ skills",
      "Specialization system"
    ],
    "replaces_core": [
      "Simple percentile rolls replaced with Resolution Table"
    ]
  },
  "resolution_table": {
    "description": "Revolutionary mechanic replacing simple percentile rolls",
    "columns": {
      "description": "Columns represent skill level or difficulty",
      "values": [
        "-X",
        "-5",
        "-4",
        "-3",
        "-2",
        "-1",
        "0",
        "/0",
        "+1",
        "+2",
        "+3",
        "+4",
        "+5",
        "+X"
      ],
      "skill_mapping": {
        "0": "Level 0 (unskilled)",
        "1-5": "Levels 1-5",
        "6+": "Level 6+",
        "/0": "Base chance without skill"
      }
    },
    "results": {
      "cobalt": {
        "description": "Maximum success",
        "effect": "Full damage, maximum effect, critical success"
      },
      "blue": {
        "description": "Good success",
        "effect": "75% of maximum effect"
      },
      "green": {
        "description": "Moderate success",
        "effect": "50% of maximum effect"
      },
      "yellow": {
        "description": "Minimal success",
        "effect": "25% of maximum effect"
      },
      "white": {
        "description": "Failure",
        "effect": "No effect, action fails"
      }
    },
    "column_shifts": {
      "description": "Modifiers that shift which column is used",
      "positive_cs": "Easier task - shift right (+10% per CS in old system)",
      "negative_cs": "Harder task - shift left (-10% per CS in old system)",
      "examples": {
        "good_conditions": "+1 to +2 CS",
        "poor_conditions": "-1 to -2 CS",
        "dexterity_modifier": "Based on DEX score"
      }
    },
    "dexterity_modifiers": {
      "01-30": "-2 CS",
      "31-40": "-1 CS",
      "41-55": "0 CS",
      "56-70": "+1 CS",
      "71-100": "+2 CS",
      "100+": "+3 CS"
    }
  },
  "new_races": {
    "description": "Three rim races added after Second Neg War",
    "grak": {
      "description": "Large, powerful marsupial-like humanoids",
      "ability_modifiers": {
        "STR": "+10",
        "STA": "+10",
        "PER": "-10",
        "LDR": "-10"
      },
      "special_abilities": [
        {
          "name": "Spring Charge",
          "description": "Can leap 20 meters forward in combat, +10% to hit on charge attack"
        },
        {
          "name": "Poison Resistance",
          "description": "+20% to resist poison and toxins"
        },
        {
          "name": "Prehensile Tail",
          "description": "Can use tail to hold items, +5% to climbing"
        }
      ],
      "movement": "10 meters/turn",
      "size": "Large"
    },
    "chiivari": {
      "description": "Small, goat-like humanoids, expert traders",
      "ability_modifiers": {
        "STR": "-5",
        "STA": "-5",
        "INT": "+5",
        "LOG": "+5"
      },
      "special_abilities": [
        {
          "name": "Inner Eyelids",
          "description": "Can close transparent inner lids, immune to eye irritants"
        },
        {
          "name": "Innate Skill",
          "description": "Free level 1 in Appraisal, Gemology, or Haggling"
        },
        {
          "name": "Trade Instinct",
          "description": "+10% to all commercial transactions"
        }
      ],
      "movement": "10 meters/turn",
      "size": "Small"
    },
    "ossivaan": {
      "description": "Tall, thin humanoids with exceptional senses",
      "ability_modifiers": {
        "STR": "+5",
        "STA": "+5",
        "DEX": "+5",
        "RS": "+5",
        "PER": "-10",
        "LDR": "-10"
      },
      "special_abilities": [
        {
          "name": "Highly Developed Smell",
          "description": "+2 CS to Tracking, can identify individuals by scent"
        },
        {
          "name": "Linguistic Aptitude",
          "description": "Can learn 4 languages at character creation"
        },
        {
          "name": "Sensory Awareness",
          "description": "+10% to detect hidden objects or creatures"
        }
      ],
      "movement": "12 meters/turn",
      "size": "Medium"
    },
    "mechanons": {
      "description": "Robot-evolved race (NPCs primarily)",
      "note": "Not recommended as player characters",
      "ability_modifiers": {
        "STR": "+20",
        "STA": "+10",
        "DEX": "+10",
        "RS": "+10",
        "INT": "-20",
        "LOG": "+10",
        "PER": "-20",
        "LDR": "+20"
      },
      "special_abilities": [
        "Ambidexterity",
        "Built-in weapons and optics",
        "Immune to poison, disease, vacuum",
        "Do not heal naturally (must be repaired)"
      ]
    }
  },
